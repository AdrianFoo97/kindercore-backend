# Database — use the MySQL connection string from Hostinger hPanel
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# Server
PORT=4000

# Auth — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET="replace-with-a-strong-random-secret"

# Google OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://yourdomain.com/api/google/callback"

# URLs
FRONTEND_URL="https://yourdomain.com"

# Google Calendar
SHARED_CALENDAR_ID="your-calendar-email@gmail.com"

# Business info
KINDER_ADDRESS="Your Kindergarten Address"

# ElevenLabs — attendance greeting TTS (Settings-generated clips per student)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="your-elevenlabs-voice-id"
# Optional, defaults to eleven_multilingual_v2 in code
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
