# Database — use the MySQL connection string from Hostinger hPanel
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# Server
PORT=4000

# Auth — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET="replace-with-a-strong-random-secret"

# Google OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://yourdomain.com/api/google/callback"

# URLs
FRONTEND_URL="https://yourdomain.com"

# Google Calendar
SHARED_CALENDAR_ID="your-calendar-email@gmail.com"

# Business info
KINDER_ADDRESS="Your Kindergarten Address"

# ElevenLabs — attendance greeting TTS (Settings-generated clips per student)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID="your-elevenlabs-voice-id"
# Optional, defaults to eleven_multilingual_v2 in code
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# AI (Settings → AI) — shared by every AI feature (e.g. reading P&Ls on import).
# Keys can be saved in Settings → AI instead; a key here takes priority. Keep real keys in .env only.
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY=""
# Optional, used until AI is set up in Settings: default provider (anthropic | openai) and its model
AI_PROVIDER=""
AI_MODEL=""
# Optional: encrypts API keys saved in Settings (32 bytes, base64). Without it they're encrypted with a key
# derived from JWT_SECRET — changing either means re-entering saved keys.
SECRETS_KEY=""
